# Copy this file to .env and fill in the values. Never commit .env.

# Required: your OpenAI API key (platform.openai.com > API keys)
OPENAI_API_KEY=

# Needed for "dev" and "start" (not for "console"): your LiveKit Cloud project
# (cloud.livekit.io > Settings > Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which playbook to load when the phone doesn't send one
PLAYBOOK_FILE=sample_playbook.json

# Which AI runs Teammate mode:
#   realtime = gpt-realtime-2.1 (takes turns, one model does everything)
#   live     = GPT-Live-1 (listens while it talks; price lookups run on a backend model)
ENGINE=realtime

# Optional settings (defaults shown)
REALTIME_MODEL=gpt-realtime-2.1
LIVE_MODEL=gpt-live-1
# Blank = LiveKit's default backend model for GPT-Live
LIVE_BACKEND_MODEL=
VOICE=marin
REASONING_EFFORT=low
CAPTION_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-4o-transcribe
SILENCE_SECONDS=30
# After Ana checks in with you: seconds before she says your name, then carries on
REP_WAIT_SECONDS=15
MAX_MINUTES=20
TIMEZONE=America/Chicago

# Optional: count minutes per rep in Supabase (see supabase/migrations/002_hola_usage.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
