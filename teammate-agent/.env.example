# Copy this file to .env and fill in the values. Never commit .env.

# Required: your OpenAI API key (platform.openai.com > API keys)
OPENAI_API_KEY=

# Needed for "dev" and "start" (not for "console"): your LiveKit Cloud project
# (cloud.livekit.io > Settings > Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# For check-phone-link.bat: LiveKit Cloud > Settings > Development token server ID (keep it private)
LIVEKIT_TOKEN_SERVER_ID=

# Which playbook to load when the phone doesn't send one
PLAYBOOK_FILE=sample_playbook.json

# Which AI runs Teammate mode:
#   realtime = gpt-realtime-2.1 (takes turns, one model does everything)
#   live     = GPT-Live-1 (listens while it talks; price lookups run on a backend model)
ENGINE=realtime

# Optional settings (defaults shown)
REALTIME_MODEL=gpt-realtime-2.1
LIVE_MODEL=gpt-live-1
# Blank = LiveKit's default backend model for GPT-Live
LIVE_BACKEND_MODEL=
VOICE=marin
REASONING_EFFORT=low
CAPTION_MODEL=gpt-4o-mini
# The second price check: reads each line about the offer against your facts (see eval_judge.py)
JUDGE_MODEL=gpt-5.6-luna
TRANSCRIBE_MODEL=gpt-transcribe
SILENCE_SECONDS=30
# After they say yes (they may be typing on your tablet): seconds of quiet before Ana hangs up
SIGNED_UP_SILENCE_SECONDS=180
# After "Quentin, are you there?": seconds before she says your name again, then carries on
REP_WAIT_SECONDS=10
MAX_MINUTES=20
TIMEZONE=America/Chicago

# Where sign-ups go when Supabase isn't set up (testing on your PC)
LEADS_FILE=leads.jsonl

# Optional: save leads and count minutes per rep in Supabase
# (see supabase/migrations/002_hola_usage.sql and 003_hola_leads.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
