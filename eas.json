{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "owner": {
      "extends": "production",
      "channel": "owner",
      "env": {
        "EXPO_PUBLIC_OWNER_BUILD": "1"
      }
    }
  },
  "submit": {
    "production": {},
    "owner": {}
  }
}
