{
  "expo": {
    "name": "Hola D2D",
    "slug": "HolaD2D",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "./plugins/withWhisperCpp",
      "expo-iap",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Hola D2D needs microphone access to listen and translate conversations in real-time.",
          "cameraPermission": "Hola D2D doesn't use your camera. The calling feature asks for this by default."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.dappily.translator",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hola D2D needs microphone access to listen and translate conversations in real-time.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F59E0B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "io.dappily.translator",
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3a27d744-8b84-44eb-9398-869c118b8110"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3a27d744-8b84-44eb-9398-869c118b8110"
    }
  }
}
